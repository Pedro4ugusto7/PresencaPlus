# Copie este arquivo para .env.local e preencha só neste computador.
# A segunda variável aceita a publishable key atual ou a chave anon legada.
# Não coloque service role, sb_secret nem a senha do banco.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço HTTPS da página publicada, sem caminho e sem barra final.
# Deixe vazio até o eas deploy mostrar a URL real. Não use localhost.
EXPO_PUBLIC_CHECK_IN_URL=
